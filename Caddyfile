{$SITE_DOMAIN:shoka.example.com} {
	encode gzip zstd

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
	}

	@vite_assets path /assets/*
	header @vite_assets Cache-Control "public, max-age=31536000, immutable"

	@html path / /
	header @html Cache-Control "no-cache"

	@api path /api/*
	header @api Cache-Control "no-store"

	@publishing path /robots.txt /sitemap.xml /feed.xml
	header @publishing Cache-Control "public, max-age=300"

	reverse_proxy app:8000
}
